# Freeze-everything policy.
# - save-exact: `npm install <pkg>` writes the exact version, never a ^ or ~ range.
# - package-lock: always write a lockfile (default, pinned explicitly so it
#   doesn't get disabled by a global ~/.npmrc).
# - fund / audit: off to keep `npm install` output quiet during builds.
# Re-pin after an intentional upgrade with `node scripts/pin-versions.mjs`.
save-exact=true
package-lock=true
fund=false
audit=false
