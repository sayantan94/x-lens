# Anthropic API
ANTHROPIC_API_KEY=

# AWS Bedrock
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# OpenRouter (open source models via API)
OPENROUTER_API_KEY=

# Groq (fast open source model inference)
GROQ_API_KEY=

# x-lens defaults
X_LENS_PROVIDER=bedrock
# Supported providers: bedrock, anthropic, openrouter, groq
# Model ID (optional — overrides default per provider)
# Anthropic: claude-sonnet-4-20250514, claude-opus-4-20250514, etc.
# Bedrock: anthropic.claude-sonnet-4-20250514-v1:0, etc.
# OpenRouter: qwen/qwen3-235b-a22b (default), or any model on openrouter.ai
# Groq: qwen/qwen3-32b (default), or any model on groq.com
X_LENS_MODEL=

# --- Trader Persona APIs ---

# Financial Modeling Prep (required by ~25 trader skills: screeners, earnings, calendars, etc.)
# Free tier: 250 calls/day | Paid: $29.99+/month
# Get your key at https://financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Alpaca (required only by portfolio-manager skill for live portfolio access)
# Get your key at https://app.alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=

# FINVIZ Elite (optional, improves dividend screeners by 70-80%)
# Only needed if you want real-time screening data
# https://finviz.com/elite.ashx
FINVIZ_EMAIL=
FINVIZ_PASSWORD=

# --- Job-Finder Persona ---

# Your professional profile (used by linkedin-outreach skill to personalize messages)
# The agent reads these to craft outreach that highlights your actual skills
X_LENS_USER_NAME=
X_LENS_USER_TITLE=
X_LENS_USER_LOCATION=
X_LENS_USER_WEBSITE=
X_LENS_USER_GITHUB=
# Comma-separated list of your technical skills
X_LENS_USER_SKILLS=
# Brief description of your relevant experience
X_LENS_USER_EXPERIENCE=
# Your LinkedIn profile URL (used to avoid self-messaging)
X_LENS_USER_LINKEDIN=

# MCP Servers (required by oi-analysis skill)
# Path to the MCP open interest server executable
MCP_OI_EXECUTABLE=/mcp-openinterest-server
# Path to the MCP market data server executable
MCP_MARKET_DATA_EXECUTABLE=/mcp-market-data-server
