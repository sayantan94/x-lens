# Anthropic API
ANTHROPIC_API_KEY=

# AWS Bedrock
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# x-lens defaults
X_LENS_PROVIDER=bedrock

# --- Trader Persona APIs ---

# Financial Modeling Prep (required by ~25 trader skills: screeners, earnings, calendars, etc.)
# Free tier: 250 calls/day | Paid: $29.99+/month
# Get your key at https://financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Alpaca (required only by portfolio-manager skill for live portfolio access)
# Get your key at https://app.alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=

# FINVIZ Elite (optional, improves dividend screeners by 70-80%)
# Only needed if you want real-time screening data
# https://finviz.com/elite.ashx
FINVIZ_EMAIL=
FINVIZ_PASSWORD=

# MCP Servers (required by oi-analysis skill)
# Path to the MCP open interest server executable
MCP_OI_EXECUTABLE=/mcp-openinterest-server
# Path to the MCP market data server executable
MCP_MARKET_DATA_EXECUTABLE=/mcp-market-data-server
